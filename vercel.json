{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/docs/README.md",
      "destination": "/docs",
      "permanent": false
    },
    {
      "source": "/docs/:path+/README.md",
      "destination": "/docs/:path+",
      "permanent": false
    },
    {
      "source": "/:folder(trang|chuyen-de|co-so-du-lieu|module-api|nghiep-vu|he-thong|chi-muc|tham-chieu|thu-vien|ban-do-kien-truc|huong-dan-doc)/:path*",
      "destination": "/docs/:folder/:path*",
      "permanent": false
    },
    {
      "source": "/docs/co-so-du-lieu",
      "destination": "/docs/chi-muc/co-so-du-lieu",
      "permanent": false
    },
    {
      "source": "/docs/trang",
      "destination": "/docs/chi-muc/danh-sach-trang",
      "permanent": false
    },
    {
      "source": "/docs/module-api",
      "destination": "/docs/chi-muc/danh-sach-api",
      "permanent": false
    },
    {
      "source": "/docs/thu-vien",
      "destination": "/docs/chi-muc/thu-vien-backend",
      "permanent": false
    },
    {
      "source": "/docs/chuyen-de",
      "destination": "/docs",
      "permanent": false
    },
    {
      "source": "/docs/nghiep-vu",
      "destination": "/docs",
      "permanent": false
    },
    {
      "source": "/docs/he-thong",
      "destination": "/docs/he-thong/01-kien-truc-runtime",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
